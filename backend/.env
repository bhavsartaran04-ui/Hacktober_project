# Copy this file to .env and fill in local values.
# Never put a real API key in this example file.

# Port = the number your computer uses to find this server.
# Render (the hosting site) will override this at runtime.
PORT=3001

# Comma-separated list of websites allowed to call this API.
# Do not use *. Local Vite app uses port 5173.
ALLOWED_ORIGINS=http://localhost:5173

# Optional. Leave empty if you do not have a key. The app still runs.
LLM_API_KEY=

# Optional overrides (Groq free-tier compatible by default).
# LLM_API_URL=https://api.groq.com/openai/v1/chat/completions
# LLM_MODEL=llama-3.1-8b-instant
